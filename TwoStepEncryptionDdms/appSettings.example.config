<?xml version="1.0" encoding="utf-8"?>
<!--
  Örnek local ayar dosyası. Bu dosyayı "appSettings.local.config" adıyla kopyalayıp doldurun.
  appSettings.local.config git'e eklenmez (.gitignore) ve Web.config tarafından otomatik okunur.

  Kolay yol: Database\setup.ps1 betiği rastgele bir parola üretir, veritabanını kurar ve bu dosyayı sizin için oluşturur.

  - DBKEY    : 2. katman (veritabanı) asimetrik anahtarının adı. Database\setup.sql "DdmsAsymKey" adıyla oluşturur.
  - DBKEYPWD : Bu anahtarın parolası. Database\setup.sql çalıştırılırken -v DbKeyPassword=... ile verdiğiniz parolayla aynı olmalıdır.
               Güçlü ve size özel bir parola seçin; bu parolayı kimseyle paylaşmayın.
-->
<appSettings>
  <add key="DBKEY" value="DdmsAsymKey" />
  <add key="DBKEYPWD" value="BURAYA-ASIMETRIK-ANAHTAR-PAROLASINI-YAZIN" />

  <!-- İsteğe bağlı: Web.config'teki varsayılanları değiştirmek için açın.
  <add key="SQL_SERVER" value=".\SQLEXPRESS" />
  <add key="SQL_DATABASE" value="TwoStepDdms" />
  <add key="SQL_AUTH" value="Trusted" />
  -->
</appSettings>
