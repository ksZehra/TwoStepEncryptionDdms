<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="TwoStepEncryptionDdms.Site" %>

<!DOCTYPE html>
<html lang="tr">
<head runat="server">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Şifreli Dinamik Veri Kayıt Sistemi</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%232563eb'/%3E%3Crect x='8' y='15' width='16' height='11' rx='2' fill='white'/%3E%3Cpath d='M12 15v-3a4 4 0 0 1 8 0v3' fill='none' stroke='white' stroke-width='2'/%3E%3C/svg%3E" />

    <link href="Content/bootstrap.min.css" rel="stylesheet" />
    <asp:PlaceHolder runat="server">
        <link href="<%= TwoStepEncryptionDdms.Common.AssetVersion.Url("~/Content/Site.css") %>" rel="stylesheet" />
        <script src="<%= TwoStepEncryptionDdms.Common.AssetVersion.Url("~/Scripts/secret-toggle.js") %>"></script>
    </asp:PlaceHolder>

    <script src="Scripts/jquery-3.3.1.min.js"></script>
    <script src="Scripts/bootstrap.min.js"></script>
    <script src="Themes/js/twostep-toast.min.js"></script>

    <script>
        // Head'de çalışır ki sayfa açılırken menü bir anlığına görünüp kaybolmasın.
        try {
            if (localStorage.getItem("sidebarCollapsed") === "1") {
                document.documentElement.classList.add("sidebar-collapsed");
            }
        } catch (e) { }
    </script>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="app-body">
    <form id="form1" runat="server">
        <a class="skip-link" href="#mainContent">İçeriğe geç</a>

        <div class="app-shell">
            <aside class="app-sidebar" id="appSidebar">
                <div class="sidebar-head">
                    <a class="brand" href="Dashboard.aspx">
                        <span class="brand-mark" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="4" y="10" width="16" height="10" rx="2"></rect>
                                <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                            </svg>
                        </span>
                        <span class="brand-text">
                            <span class="brand-name">Veri Kayıt Sistemi</span>
                            <span class="brand-note">İki Adımlı Şifreleme</span>
                        </span>
                    </a>
                    <button type="button" class="sidebar-collapse" id="sidebarCollapse" aria-label="Menüyü gizle" title="Menüyü gizle" aria-controls="appSidebar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                            <path d="M9 4v16"></path>
                            <path d="m16 10-2 2 2 2"></path>
                        </svg>
                    </button>
                </div>

                <nav class="app-nav" aria-label="Ana menü">
                    <div class="nav-label">Çalışma Alanı</div>
                    <ul>
                        <li runat="server" id="liDashboard">
                            <a href="Dashboard.aspx">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="4" y="4" width="7" height="7" rx="1"></rect>
                                    <rect x="13" y="4" width="7" height="7" rx="1"></rect>
                                    <rect x="4" y="13" width="7" height="7" rx="1"></rect>
                                    <rect x="13" y="13" width="7" height="7" rx="1"></rect>
                                </svg>
                                Ana Sayfa
                            </a>
                        </li>
                        <li runat="server" id="liTablolar" visible="false">
                            <a href="TableSchemaList.aspx">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12 3 3 8l9 5 9-5-9-5Z"></path>
                                    <path d="m3 12 9 5 9-5"></path>
                                    <path d="m3 16 9 5 9-5"></path>
                                </svg>
                                Veri Kümeleri
                            </a>
                        </li>
                        <li runat="server" id="liKayitlar" visible="false">
                            <a href="Record.aspx">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                                    <path d="M3 9h18"></path>
                                    <path d="M3 14h18"></path>
                                    <path d="M8 4v16"></path>
                                </svg>
                                Kayıtlar
                            </a>
                        </li>
                    </ul>
                </nav>

                <div class="sidebar-foot">
                    <button type="button" class="sidebar-credit" data-toggle="modal" data-target="#hakkinda" title="Geliştirici hakkında">
                        <asp:PlaceHolder runat="server">
                            <img src="<%= TwoStepEncryptionDdms.Common.AssetVersion.Url("~/Content/img/zk-logo.svg") %>" alt="" aria-hidden="true" />
                        </asp:PlaceHolder>
                        <span>© 2023 <strong>Zehra Nur Köse</strong></span>
                    </button>
                </div>
            </aside>

            <div class="sidebar-overlay" id="sidebarOverlay"></div>

            <div class="app-main">
                <header class="app-topbar">
                    <div class="topbar-inner">
                        <button type="button" class="nav-toggle" id="sidebarToggle" aria-label="Menüyü göster" title="Menüyü göster" aria-controls="appSidebar" aria-expanded="false">
                            <span></span>
                            <span></span>
                            <span></span>
                        </button>

                        <span class="topbar-kicker">Şifreli Dinamik Veri Kayıt Sistemi</span>

                        <div class="user-menu">
                            <span class="user-chip">
                                <span class="user-avatar" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="8" r="3.5"></circle>
                                        <path d="M5 20a7 7 0 0 1 14 0"></path>
                                    </svg>
                                </span>
                                <asp:Label ID="lblSession" runat="server" CssClass="user-name" Text=""></asp:Label>
                            </span>
                            <a id="linkHesap" runat="server" class="btn btn-default btn-sm" href="Account.aspx">Hesabım</a>
                            <a href="#" class="btn btn-default btn-sm" data-toggle="modal" data-target="#oturumu-kapat">Çıkış</a>
                        </div>
                    </div>
                </header>

                <main class="app-content" id="mainContent">
                    <div class="page-toolbar" id="divUst2">
                        <asp:ContentPlaceHolder ID="cphButon" runat="server">
                        </asp:ContentPlaceHolder>
                        <asp:Label ID="lblErrorMsg" runat="server" CssClass="form-alert" Text=""></asp:Label>
                    </div>

                    <div class="page-body">
                        <asp:ContentPlaceHolder ID="cphSagIcerik" runat="server">
                        </asp:ContentPlaceHolder>
                    </div>
                </main>
            </div>
        </div>

        <div class="modal fade" id="hakkinda" tabindex="-1" role="dialog" aria-labelledby="hakkindaBaslik">
            <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
                <div class="modal-content about-card">
                    <button type="button" class="about-close" data-dismiss="modal" aria-label="Kapat" title="Kapat">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M18 6 6 18"></path>
                            <path d="m6 6 12 12"></path>
                        </svg>
                    </button>
                    <asp:PlaceHolder runat="server">
                        <img class="about-logo" src="<%= TwoStepEncryptionDdms.Common.AssetVersion.Url("~/Content/img/zk-logo.svg") %>" alt="" aria-hidden="true" />
                    </asp:PlaceHolder>
                    <h4 class="about-title" id="hakkindaBaslik">Şifreli Dinamik Veri Kayıt Sistemi</h4>
                    <asp:PlaceHolder runat="server">
                        <span class="about-version">Sürüm <%: TwoStepEncryptionDdms.AppConfig.AppVersion %> · 2023</span>
                    </asp:PlaceHolder>
                    <div class="about-body">
                        <strong class="about-name">Zehra Nur Köse</strong>
                        <a class="about-link" href="https://github.com/ksZehra" target="_blank" rel="noopener noreferrer">
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a10.9 10.9 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path>
                            </svg>
                            github.com/ksZehra
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="oturumu-kapat" tabindex="-1" role="dialog" aria-labelledby="cikisBaslik">
            <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title" id="cikisBaslik">Oturumu kapat</h4>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0 text-muted">Oturumu kapatmak istediğinizden emin misiniz?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">Vazgeç</button>
                        <asp:Button ID="btnCikisYap" runat="server" CssClass="btn btn-danger" Text="Çıkış Yap" ClientIDMode="Static" OnClick="btnCikisYap_Click" />
                    </div>
                </div>
            </div>
        </div>
    </form>

    <script type="text/javascript">
(function () {
    var sidebar = document.getElementById("appSidebar");
    var overlay = document.getElementById("sidebarOverlay");
    var toggle = document.getElementById("sidebarToggle");
    var collapseBtn = document.getElementById("sidebarCollapse");

    if (!sidebar || !overlay || !toggle || !collapseBtn) {
        return;
    }

    var root = document.documentElement;
    var desktopQuery = window.matchMedia("(min-width: 992px)");

    function isCollapsed() {
        return root.classList.contains("sidebar-collapsed");
    }

    function syncExpanded() {
        var expanded = desktopQuery.matches ? !isCollapsed() : sidebar.classList.contains("is-open");
        toggle.setAttribute("aria-expanded", expanded ? "true" : "false");
    }

    function setOpen(open) {
        sidebar.classList.toggle("is-open", open);
        overlay.classList.toggle("is-visible", open);
        syncExpanded();
    }

    function setCollapsed(collapsed) {
        root.classList.toggle("sidebar-collapsed", collapsed);
        try {
            localStorage.setItem("sidebarCollapsed", collapsed ? "1" : "0");
        } catch (e) { }
        syncExpanded();
        (collapsed ? toggle : collapseBtn).focus();
    }

    toggle.addEventListener("click", function () {
        if (desktopQuery.matches) {
            setCollapsed(false);
        } else {
            setOpen(!sidebar.classList.contains("is-open"));
        }
    });

    collapseBtn.addEventListener("click", function () {
        if (desktopQuery.matches) {
            setCollapsed(true);
        } else {
            setOpen(false);
        }
    });

    overlay.addEventListener("click", function () {
        setOpen(false);
    });

    window.addEventListener("resize", function () {
        if (desktopQuery.matches) {
            setOpen(false);
        }
        syncExpanded();
    });

    syncExpanded();
})();

(function () {
    var links = document.querySelectorAll(".data-table .col-actions a");
    Array.prototype.forEach.call(links, function (link) {
        var label = (link.textContent || "").trim();
        if (!label) {
            return;
        }
        if (!link.title) {
            link.title = label;
        }
        if (!link.getAttribute("aria-label")) {
            link.setAttribute("aria-label", link.title || label);
        }
    });
})();
</script>
</body>
</html>
